# LLM API key (OpenAI, Azure OpenAI, or any OpenAI-compatible gateway)
OPENAI_API_KEY=
OPENAI_API_ENDPOINT=https://api.openai.com/v1
MODEL=gpt-4o-mini

# Azure OpenAI: set both to route through Azure
AZURE_API_VERSION=
AZURE_DEPLOYMENT=

# Review settings
LANGUAGE=
PROMPT=
temperature=1
top_p=1
max_tokens=10000
REASONING_EFFORT=
TARGET_LABEL=
MAX_PATCH_LENGTH=10000
IGNORE_PATTERNS=
INCLUDE_PATTERNS=
OPENAI_EXTRA_HEADERS=
OPENCODE_SESSION=
