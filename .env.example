# LLM API key (OpenAI compatible, or GitHub Models token)
OPENAI_API_KEY=
OPENAI_API_ENDPOINT=https://api.openai.com/v1
MODEL=gpt-4o-mini

# Review settings
LANGUAGE=
PROMPT=
temperature=1
top_p=1
max_tokens=10000
REASONING_EFFORT=
TARGET_LABEL=
MAX_PATCH_LENGTH=10000
IGNORE_PATTERNS=
INCLUDE_PATTERNS=
OPENAI_EXTRA_HEADERS=
OPENCODE_SESSION=

# GitHub Models mode (uses GITHUB_TOKEN instead of OPENAI_API_KEY)
USE_GITHUB_MODELS=
GITHUB_TOKEN=

# Logging
LOG_LEVEL=info
